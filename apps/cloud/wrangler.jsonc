{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pupu",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "Pupu", "class_name": "Pupu" },
      { "name": "Directory", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Pupu"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],
  // 手机和电脑 App 的默认地址还是 workers.dev，加了 routes 也要留着。
  "workers_dev": true,
  "routes": [{ "pattern": "app.getpupu.com", "custom_domain": true }],
  // 开 Pupu 的总名额，还要有邀请码；0 是不开放。每个 Pupu 每天的模型费用上限，美元。
  "vars": { "PUPU_SEATS": "20", "PUPU_DAILY_USD": "0.5" },
  "observability": { "enabled": true }
}
