{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pupu-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "getpupu.com", "custom_domain": true },
    { "pattern": "www.getpupu.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pupu-site",
      "database_id": "375eb498-42f7-4eab-8f49-183ece80b14b"
    }
  ],
  "ratelimits": [
    { "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
