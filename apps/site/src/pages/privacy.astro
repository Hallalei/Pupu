---
import Base from "../layouts/Base.astro";

// 上线前配一个公开的联系邮箱（PUBLIC_CONTACT_EMAIL）。没配时不显示这一句。
const contact = import.meta.env.PUBLIC_CONTACT_EMAIL as string | undefined;
---

<Base title="隐私说明 · Pupu" description="Pupu 官网收集什么、怎么用。">
  <main class="prose-wrap">
    <article class="panel prose">
      <h1>隐私说明</h1>
      <p>这一页讲官网。Pupu App 的数据怎么处理，以 App 里的隐私说明为准。</p>

      <h2>官网收集什么</h2>
      <p>只有你在「申请内测」里填的邮箱和申请时间。不记 IP，不放 Cookie，不接统计和广告工具。</p>

      <h2>用来做什么</h2>
      <p>只用来发内测邀请。不卖，不分享给第三方，不用来投放广告。</p>

      <h2>存在哪里</h2>
      <p>存在 Cloudflare 的数据库里。为了防止滥用，Cloudflare 会短暂按 IP 限制提交频率，这个 IP 不写进我们的数据库。</p>

      {contact && (
        <>
          <h2>想删掉</h2>
          <p>发信到 <a href={`mailto:${contact}`}>{contact}</a>，我们会把你的邮箱删掉。</p>
        </>
      )}

      <h2>用上 Pupu 之后</h2>
      <p>你们的对话和项目存在云端，Pupu 读得到内容，这样才能接着做事。Pupu 不做端到端加密。对话内容会发给 AI 模型服务来生成回复。</p>
      <p>每人有一条私聊，别的成员和创建者在 App 里都看不到。但部署这个 Pupu 的人，技术上能读到它的数据库。</p>
    </article>
  </main>
</Base>
