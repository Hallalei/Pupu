---
/** 网页没有 SF Symbols，这里手画几个对应的线性图标，名字沿用规范里的说法。 */
interface Props {
  name: keyof typeof PATHS;
  class?: string;
}

const PATHS = {
  folder: "M3 7.5A2.5 2.5 0 0 1 5.5 5H9l2.2 2.4h7.3A2.5 2.5 0 0 1 21 9.9v7.6a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 17.5z",
  terminal: "M4 6.5 10 12l-6 5.5M12.5 18H20",
  doc: "M7 3.5h6.5L18.5 8.5V20.5H7zM13.5 3.5v5h5",
  desktop: "M3.5 5h17v11h-17zM9 20h6M12 16v4",
  hand: "M8 11V6.2a1.4 1.4 0 0 1 2.8 0V10m0 0V4.9a1.4 1.4 0 0 1 2.8 0V10m0 0V6a1.4 1.4 0 0 1 2.8 0v8.5c0 3.6-2.4 6-5.6 6-2.6 0-4-1.1-5.3-3.2L3.6 13a1.4 1.4 0 0 1 2.3-1.5L8 14",
  chevron: "m9 6 6 6-6 6",
  check: "m5 12.5 4.5 4.5L19 7.5",
  muted: "M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM16 9.5l5 5M21 9.5l-5 5",
  sound: "M4 9.5v5h3.5L12 18.5v-13L7.5 9.5zM15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.8 7.8 0 0 1 0 11"
} as const;

const { name, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={PATHS[name]}></path>
</svg>
